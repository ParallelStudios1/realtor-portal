{
  "expo": {
    "name": "Realtor Portal",
    "slug": "realtor-portal",
    "version": "0.1.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.parallelstudios.realtorportal",
      "associatedDomains": [
        "applinks:realtorportal.parallelstudios.co",
        "applinks:realtor-portal-ten.vercel.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Realtor Portal needs access to your photo library so you can attach photos and documents to a deal — for example, selecting a photo of a property to add to a listing, or a scanned disclosure to share with your client.",
        "NSCameraUsageDescription": "Realtor Portal needs access to your camera so you can photograph documents and properties directly into a deal — for example, taking a picture of a signed inspection report to upload to the file.",
        "NSMicrophoneUsageDescription": "Realtor Portal needs access to your microphone to record audio when you capture a video walkthrough of a property to share with your client."
      }
    },
    "android": {
      "package": "com.parallelstudios.realtorportal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "realtorportal.parallelstudios.co",
              "pathPrefix": "/welcome"
            },
            {
              "scheme": "https",
              "host": "realtorportal.parallelstudios.co",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "realtor-portal-ten.vercel.app",
              "pathPrefix": "/welcome"
            },
            {
              "scheme": "https",
              "host": "realtor-portal-ten.vercel.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-document-picker",
      "expo-image-picker",
      "expo-iap"
    ],
    "scheme": "realtorportal",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ec40b9d-760a-4b14-81eb-8de0f06e9fdb"
      }
    },
    "owner": "parallelstudios"
  }
}
